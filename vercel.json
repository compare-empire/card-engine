{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "claude/*": false,
      "claude/**": false,
      "reports": false,
      "forum": false,
      "ops-status": false
    }
  },
  "ignoreCommand": "bash scripts/vercel-ignore-build.sh",
  "buildCommand": "bash scripts/use-site.sh --copy && next build"
}
